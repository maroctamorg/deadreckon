---
interface Props {
  title: string;
  description?: string;
}

import "@/styles/global.css";

import topBrand from "../resources/ornaments/top-brand.svg?raw";
import edgeFrame from "../resources/ornaments/edge-frame.svg?raw";

const { title, description = "A markdown-driven learning platform." } = Astro.props;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="description" content={description} />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{title}</title>
  </head>
  <body>
    <header class="site-header">
      <div class="site-header__row">
        <a class="site-title" href="/">Dead Reckon</a>
      </div>
      <div class="ornament ornament--top" aria-hidden="true" set:html={topBrand} />
    </header>

    <!-- <div class="ornament ornament--left" aria-hidden="true">
      <div class="ornament__svg" set:html={edgeFrame} />
    </div>

    <div class="ornament ornament--right" aria-hidden="true">
      <div class="ornament__svg ornament__svg--flip" set:html={edgeFrame} />
    </div> -->

    <main class="page-shell">
      <slot />
    </main>
  </body>
</html>
