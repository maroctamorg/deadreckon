---
import BaseLayout from "@/layouts/BaseLayout.astro";
import type { Problem } from "@/domain/content/index.ts";
import { GetTopicPath, LoadContentGraph, RenderSectionHtml } from "@/generation/site.ts";

interface Props {
  problem: Problem;
}

export async function getStaticPaths() {
  const graph = await LoadContentGraph();

  return graph.problems.map((node) => ({
    params: { id: node.page.id },
    props: { problem: node.page }
  }));
}

const { problem } = Astro.props as Props;

const problemStatementHtml = await RenderSectionHtml(problem.statement.content);
const problemHintsHtml = problem.hints === null ? null : await RenderSectionHtml(problem.hints.content);
const problemSketchHtml = problem.sketch === null ? null : await RenderSectionHtml(problem.sketch.content);
const problemModelSolutionHtml =
  problem.modelSolution === null ? null : await RenderSectionHtml(problem.modelSolution.content);
const problemSummaryHtml =
  problem.summary === null ? null : await RenderSectionHtml(problem.summary.content);
---

<BaseLayout title={problem.title} description={problem.statement.content}>
  <section class="page-hero">
    <h1 class="page-title">{problem.title}</h1>
  </section>

  <article class="content-page">

    {problem.topicReferences !== null && (
      <section class="content-section">
        <h2>Topic</h2>
        <ul class="link-list">
          {problem.topicReferences.map((topic) => (
            <li>
              <a href={GetTopicPath(topic.title)}>{topic.title}</a>
            </li>
          ))}
        </ul>
      </section>
    )}

    <section class="content-section">
      <h2>Statement</h2>
      <div class="section-body" set:html={problemStatementHtml} />
    </section>

    {problem.hints !== null && (
      <section class="content-section">
        <details>
          <summary>Hints</summary>
          <div class="section-body" set:html={problemHintsHtml} />
        </details>
      </section>
    )}

    {problem.sketch !== null && (
      <section class="content-section">
        <details>
          <summary>Sketch</summary>
          <div class="section-body" set:html={problemSketchHtml} />
        </details>
      </section>
    )}

    {problem.modelSolution !== null && (
      <section class="content-section">
        <details>
          <summary>Model Solution</summary>
          <div class="section-body" set:html={problemModelSolutionHtml} />
        </details>
      </section>
    )}

    {problem.summary !== null && (
      <section class="content-section">
        <details>
          <summary>Summary and Key Ideas</summary>
          <div class="section-body" set:html={problemSummaryHtml} />
        </details>
      </section>
    )}
  </article>
</BaseLayout>