---
import BaseLayout from "@/layouts/BaseLayout.astro";
import type { Topic } from "@/domain/content/index.ts";
import { GetProblemPath, GetTopicPath, LoadContentGraph, RenderSectionHtml } from "@/generation/site.ts";

interface Props {
  topic: Topic;
}

export async function getStaticPaths() {
  const graph = await LoadContentGraph();

  return graph.topics.map((node) => ({
    params: { id: node.page.id },
    props: { topic: node.page }
  }));
}

const { topic } = Astro.props as Props;

const topicSummaryHtml =
  topic.summary === null ? null : await RenderSectionHtml(topic.summary.content);
const topicOverviewHtml =
  topic.overview === null ? null : await RenderSectionHtml(topic.overview.content);
const topicReferencesHtml =
  topic.references === null ? null : await RenderSectionHtml(topic.references.content);
---

<BaseLayout title={topic.title} description={topic.overview?.content ?? topic.title}>
  <section class="page-hero">
    <h1 class="page-title">{topic.title}</h1>
  </section>

  <article class="content-page">
    {topic.dependencies !== null && (
      <section class="content-section">
        <h2>Dependencies</h2>
        <ul class="link-list">
          {topic.dependencies.map((dependency) => (
            <li>
              <a href={GetTopicPath(dependency.title)}>{dependency.title}</a>
            </li>
          ))}
        </ul>
      </section>
    )}

    {topic.summary !== null && (
      <section class="content-section">
        <h2>Summary</h2>
        <div class="section-body" set:html={topicSummaryHtml} />
      </section>
    )}

    {topic.overview !== null && (
      <section class="content-section">
        <h2>Overview</h2>
        <div class="section-body" set:html={topicOverviewHtml} />
      </section>
    )}

    {topic.problemReferences !== null && (
      <section class="content-section">
        <h2>Problems</h2>
        <ul class="link-list">
          {topic.problemReferences.map((problem) => (
            <li>
              <a href={GetProblemPath(problem.title)}>{problem.title}</a>
            </li>
          ))}
        </ul>
      </section>
    )}

    {topic.references !== null && (
      <section class="content-section">
        <h2>References</h2>
        <div class="section-body" set:html={topicReferencesHtml} />
      </section>
    )}
  </article>
</BaseLayout>