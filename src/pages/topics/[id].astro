---
import BaseLayout from "@/layouts/BaseLayout.astro";
import type { Topic } from "@/domain/content/index.ts";
import { GetProblemPath, GetTopicPath, LoadContentGraph, RenderSectionHtml } from "@/generation/site.ts";

interface Props {
  topic: Topic;
}

export async function getStaticPaths() {
  const graph = await LoadContentGraph();

  return graph.topics.map((node) => ({
    params: { id: node.page.id },
    props: { topic: node.page }
  }));
}

const { topic } = Astro.props as Props;
---

<BaseLayout title={topic.title} description={topic.overview?.content ?? topic.title}>
  <section class="page-hero">
    <nav class="page-hero__nav" aria-label="Main navigation">
      <a href="/">Home</a>
      <a href="/#topics">Topics</a>
    </nav>

    <p class="eyebrow">Topic</p>
    <h1 class="page-title">{topic.title}</h1>
    <p class="page-intro">Linked dependencies, overview, and related problems below.</p>
  </section>

  <article class="content-page">
    {topic.dependencies !== null && (
      <section class="content-section">
        <h2>Dependencies</h2>
        <ul class="link-list">
          {topic.dependencies.map((dependency) => (
            <li>
              <a href={GetTopicPath(dependency.title)}>{dependency.title}</a>
            </li>
          ))}
        </ul>
      </section>
    )}

    {topic.overview !== null && (
      <section class="content-section">
        <h2>Overview</h2>
        <div class="section-body" set:html={RenderSectionHtml(topic.overview.content)} />
      </section>
    )}

    {topic.problemReferences !== null && (
      <section class="content-section">
        <h2>Problems</h2>
        <ul class="link-list">
          {topic.problemReferences.map((problem) => (
            <li>
              <a href={GetProblemPath(problem.title)}>{problem.title}</a>
            </li>
          ))}
        </ul>
      </section>
    )}

    {topic.references !== null && (
      <section class="content-section">
        <h2>References</h2>
        <div class="section-body" set:html={RenderSectionHtml(topic.references.content)} />
      </section>
    )}

    {topic.summary !== null && (
      <section class="content-section">
        <details>
          <summary>Summary and Key Ideas</summary>
          <div class="details-hint">Tap to expand this optional section.</div>
          <div class="section-body" set:html={RenderSectionHtml(topic.summary.content)} />
        </details>
      </section>
    )}
  </article>
</BaseLayout>